{
  "buildCommand": "pip install -r requirements.txt",
  "devCommand": "uvicorn main:app --host 0.0.0.0 --port 3000",
  "installCommand": "pip install -r requirements.txt",
  "framework": null,
  "functions": {
    "api/**/*.py": {
      "runtime": "@vercel/python@4.0.0"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/main.py" }
  ]
}
